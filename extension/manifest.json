{
  "name": "Tango Tab: Daily Japanese Words",
  "description": "A new tab with daily Japanese flashcards, based on your JLPT level.",
  "version": "1.0.0",
  "manifest_version": 3,
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tangotab@astralux.dev",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
